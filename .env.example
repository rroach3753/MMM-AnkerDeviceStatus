# Copy to .env in this module directory. Never commit real credentials.
ANKER_EMAIL=you@example.com
ANKER_PASSWORD=
# Two-letter country code for your Anker account, not your mirror's location.
ANKER_COUNTRY=US
# Cloud polling must be at least 60 seconds. Device discovery runs less often.
ANKER_POLL_INTERVAL=300
ANKER_DETAILS_INTERVAL=1800
ANKER_MQTT=true
ANKER_MQTT_STALE_SECONDS=600
# Optional absolute Python interpreter path (set in MagicMirror's environment).
# ANKER_PYTHON=/home/pi/MagicMirror/modules/MMM-AnkerDeviceStatus/.venv/bin/python
